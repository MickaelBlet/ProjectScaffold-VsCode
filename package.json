{
  "name": "project-scaffold-vscode",
  "displayName": "ProjectScaffold",
  "description": "Software architecture editor for *.scaffold.yaml files: modules, ports, typed interfaces and links",
  "version": "1.0.0",
  "publisher": "mblet",
  "author": "Mickaël Blet",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MickaelBlet/ProjectScaffold-VsCode"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json",
    "workspaceContains:**/*.scaffold.{yaml,yml,json}",
    "onWebviewPanel:projectScaffold.preview"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**/*.js",
    "media/**",
    "resources/**",
    "LICENSE",
    "THIRD.md"
  ],
  "scripts": {
    "viewer": "scripts/build_viewer.sh",
    "typecheck": "tsc -p .",
    "compile": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "media": "mkdir -p media && cp viewer/dist-web/index.html viewer/electron/icon.png media/",
    "build": "npm run viewer && npm run compile && npm run media",
    "package": "npm run build && mkdir -p dist-vscode && vsce package $npm_package_version --no-git-tag-version --no-update-package-json --no-dependencies --out dist-vscode/",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectScaffold",
          "title": "ProjectScaffold",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "projectScaffold": [
        {
          "type": "webview",
          "id": "projectScaffold.panel",
          "name": "ProjectScaffold"
        }
      ]
    },
    "commands": [
      {
        "command": "projectScaffold.showPreview",
        "title": "Open Preview",
        "category": "ProjectScaffold",
        "icon": "$(open-preview)"
      },
      {
        "command": "projectScaffold.showSource",
        "title": "Show Source",
        "category": "ProjectScaffold",
        "icon": "$(go-to-file)"
      },
      {
        "command": "projectScaffold.layoutFull",
        "title": "Switch to Full Layout",
        "category": "ProjectScaffold",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "projectScaffold.layoutIntegrated",
        "title": "Switch to Integrated Layout",
        "category": "ProjectScaffold",
        "icon": "$(layout-sidebar-left-off)"
      },
      {
        "command": "projectScaffold.addModule",
        "title": "Add Module",
        "category": "ProjectScaffold",
        "icon": "$(add)"
      },
      {
        "command": "projectScaffold.arrange",
        "title": "Auto-arrange",
        "category": "ProjectScaffold",
        "icon": "$(layout)"
      },
      {
        "command": "projectScaffold.exportPng",
        "title": "Export Diagram as PNG…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.exportSvg",
        "title": "Export Diagram as SVG…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.importSettings",
        "title": "Import Settings…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.exportSettings",
        "title": "Export Settings…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.search",
        "title": "Show Search Panel",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.problems",
        "title": "Show Problems Panel",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.output",
        "title": "Show Output Panel",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.noop",
        "title": "Handled by the diagram",
        "category": "ProjectScaffold"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "projectScaffold.showPreview",
          "when": "resourceExtname =~ /^\\.(ya?ml|json)$/ && !projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.showSource",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.layoutFull",
          "when": "projectScaffold.diagramActive && projectScaffold.layout != 'full'"
        },
        {
          "command": "projectScaffold.layoutIntegrated",
          "when": "projectScaffold.diagramActive && projectScaffold.layout == 'full'"
        },
        {
          "command": "projectScaffold.addModule",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.arrange",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.exportPng",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.exportSvg",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.importSettings",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.exportSettings",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.search",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.problems",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.output",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.noop",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "projectScaffold.showPreview",
          "when": "resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/ && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation"
        },
        {
          "command": "projectScaffold.showSource",
          "when": "projectScaffold.diagramActive",
          "group": "navigation@1"
        },
        {
          "command": "projectScaffold.layoutFull",
          "when": "projectScaffold.diagramActive && projectScaffold.layout != 'full'",
          "group": "navigation@2"
        },
        {
          "command": "projectScaffold.layoutIntegrated",
          "when": "projectScaffold.diagramActive && projectScaffold.layout == 'full'",
          "group": "navigation@2"
        },
        {
          "command": "projectScaffold.exportPng",
          "when": "projectScaffold.diagramActive",
          "group": "export"
        },
        {
          "command": "projectScaffold.exportSvg",
          "when": "projectScaffold.diagramActive",
          "group": "export"
        }
      ],
      "explorer/context": [
        {
          "command": "projectScaffold.showPreview",
          "when": "resourceExtname =~ /^\\.(ya?ml|json)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "command": "projectScaffold.showPreview",
        "when": "editorTextFocus && resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/"
      },
      {
        "key": "ctrl+e",
        "mac": "cmd+e",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+d",
        "mac": "cmd+d",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+a",
        "mac": "cmd+a",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+m",
        "mac": "cmd+m",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+p",
        "mac": "cmd+p",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+0",
        "mac": "cmd+0",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+g",
        "mac": "cmd+g",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+l",
        "mac": "cmd+l",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+i",
        "mac": "cmd+i",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+,",
        "mac": "cmd+,",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+left",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+right",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+enter",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+g",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+i",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+m",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+o",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+u",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+z",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "f1",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "f2",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      }
    ],
    "configuration": {
      "title": "ProjectScaffold",
      "properties": {
        "projectScaffold.syncSelection": {
          "type": "boolean",
          "default": true,
          "description": "Move the text cursor to the entity selected in the diagram, and select in the diagram the entity under the text cursor."
        },
        "projectScaffold.views.revealOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Show the ProjectScaffold side bar when a project file is first opened in the window."
        },
        "projectScaffold.preview.layout": {
          "type": "string",
          "enum": [
            "integrated",
            "full"
          ],
          "enumDescriptions": [
            "Explorer in the ProjectScaffold side bar, the Inspector and Settings in the preview",
            "Every tool docked in the preview, like the web app"
          ],
          "default": "integrated",
          "markdownDescription": "Layout of the diagram preview. _Switch to Full Layout_ / _Switch to Integrated Layout_ (editor title bar, toolbar of the diagram) change it for every preview."
        },
        "projectScaffold.preview.position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "Left of the text",
            "Right of the text"
          ],
          "default": "left",
          "description": "Where Open Preview to the Side places the diagram."
        },
        "projectScaffold.preview.showSideBar": {
          "type": "boolean",
          "default": true,
          "description": "Opening a preview shows the ProjectScaffold side bar (Explorer), in the integrated layout."
        }
      }
    }
  }
}
